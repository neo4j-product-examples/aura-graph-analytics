# Aura Graph Analytics API credentials (Aura Console > Graph Analytics > API credentials)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Snowflake connection (source of the MTA data)
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=
# Key-pair auth: path to your private key (see the README for how to generate it)
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# Only if the private key is encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
